NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Public business contact information. Safe to expose to the browser.
# These are bundled into the client because Next.js only exposes env vars
# to the frontend when they are prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_INSTAGRAM=

# Server-only secrets. NEVER prefix these with NEXT_PUBLIC_.
# RESEND_API_KEY: API key from the Resend dashboard.
# CONTACT_EMAIL: Destination inbox that receives enquiries.
# CONTACT_FROM_EMAIL: Verified sender address Resend uses for the From header.
RESEND_API_KEY=
CONTACT_EMAIL=
CONTACT_FROM_EMAIL=
